# setup.env.example — NON-SECRET template of the tunables setup.sh reads.
#
# Copy to setup.env (git-ignored) and edit as needed, then run `sudo ./setup.sh`:
#   cp setup.env.example setup.env
#   $EDITOR setup.env
#
# EVERY key here is OPTIONAL — setup.sh has safe defaults for all of them and needs
# nothing to run. This file holds NO secrets; the web password/hash and backup
# destination credentials are generated/stored on-device in secrets/service.env
# (0600, git-ignored). Do NOT put a password or private key in this file.

# LAN address Caddy publishes the site on (:443). Use the host's LAN NIC IP or a
# local hostname. Never 0.0.0.0. Default: <LAN_IP>
MOCKINGBUOY_SITE=<LAN_IP>

# Basic-auth username guarding the whole site. Default: <you>
MOCKINGBUOY_BASIC_USER=<you>

# Loopback port the ASGI app binds (Caddy reverse-proxies to it). The app is never
# published directly; only Caddy's :443 is. Default: 8000
APP_PORT=8000

# Management subnet allowed to reach the web port (and any TCP taps) when the
# optional firewall is enabled. CIDR form. Default: <subnet>
ALLOW_SUBNET=<subnet>

# Optional: turn on the host firewall (UFW) hardening. When true, setup.sh sets
# default-deny-incoming, allows OpenSSH, and allows ALLOW_SUBNET to :443 + each
# TAP_PORTS entry. Anything other than "true" skips firewall changes. Default: false
ENABLE_UFW=false

# Optional: per-channel raw TCP tap ports to open in the firewall (space- or
# comma-separated), matched to channels[].tcp_tap in config. Empty = none.
TAP_PORTS=

# Optional: upstream NTP server for chrony. Empty = use the distro defaults.
CHRONY_SERVER=

# Optional: rsync destination for the daily host backup timer (LAN share), e.g.
#   BACKUP_DEST=<user@host:/path/to/backups/mockingbuoy>
# Empty = the backup timer is NOT enabled. Stored into secrets/service.env as
# MOCKINGBUOY_BACKUP_DEST. Default: empty
BACKUP_DEST=
