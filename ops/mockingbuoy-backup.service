# mockingbuoy — host backup (oneshot). Paired with mockingbuoy-backup.timer.
#
# Rsyncs the irreplaceable state to a LAN share: config, on-device secrets, the Caddy
# custom root CA + issued certs, and runtime data/. Everything else is rebuildable from
# the repo + wheelhouse, so it is deliberately NOT included.
#
# Install:
#   sudo install -m 0644 ops/mockingbuoy-backup.service /etc/systemd/system/
#   sudo install -m 0644 ops/mockingbuoy-backup.timer   /etc/systemd/system/
#   # set the destination once (git-ignored secrets/service.env carries the env):
#   #   MOCKINGBUOY_BACKUP_DEST=user@nas.lan:/backups/mockingbuoy
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mockingbuoy-backup.timer
#   sudo systemctl start mockingbuoy-backup.service   # test one run now
#
# Restore drill: see docs/ref/security.md ("Backups & restore").

[Unit]
Description=mockingbuoy host backup (config + secrets + Caddy CA + data)
Documentation=file:///opt/mockingbuoy/docs/ref/security.md
After=network-online.target
Wants=network-online.target
# Fail fast (not hang) if the install is missing its config.
AssertPathExists=/opt/mockingbuoy/config.json

[Service]
Type=oneshot
User=mockingbuoy
Group=mockingbuoy

# MOCKINGBUOY_BACKUP_DEST=<rsync destination> (LAN share, e.g. user@host:/path, or a
# locally-mounted share). This backup carries SENSITIVE material — the Caddy root CA
# private key and the Basic-auth hash — so use an ENCRYPTED transport (rsync-over-ssh,
# user@host:/path) and a destination readable only by you. Avoid clear rsync-daemon
# (host::module) or world-readable mounts. For stricter DR, exclude the CA private key
# and re-mint it on restore, or encrypt the backup at rest.
# Note: for an rsync-over-ssh destination the service user's
# ~/.ssh must be reachable — set the user's home to /opt/mockingbuoy (not under /home,
# which ProtectHome=true hides) or use a mounted-share destination path.
EnvironmentFile=-/opt/mockingbuoy/secrets/service.env

# CA handling (C3): the Caddy custom root CA lives under the caddy user's state dir. We
# stage ONLY the PUBLIC root certificate (root.crt) — the material clients need to trust —
# into data/; the CA PRIVATE key (root.key) is DELIBERATELY NOT copied. Staging root.key
# into data/ (the app's own ReadWritePaths) was a root-CA-key leak: any file-read/RCE bug
# in the FastAPI app could exfiltrate it and mint trusted certs to MITM the front door.
# On restore the CA private key is re-minted (clients re-import the new public root.crt),
# which is the correct trade for a DR appliance. The '|| true' tolerates a not-yet-
# provisioned CA on first run.
ExecStartPre=+/bin/sh -c 'set -e; mkdir -p /opt/mockingbuoy/data/caddy-ca; \
    find /var/lib/caddy/.local/share/caddy/pki/authorities/local -maxdepth 1 -name "*.crt" \
        -exec cp -a {} /opt/mockingbuoy/data/caddy-ca/ \; 2>/dev/null || true; \
    rm -f /opt/mockingbuoy/data/caddy-ca/*.key 2>/dev/null || true; \
    chown -R mockingbuoy:mockingbuoy /opt/mockingbuoy/data/caddy-ca; \
    chmod -R go-rwx /opt/mockingbuoy/data/caddy-ca'

# --relative preserves the /opt/mockingbuoy/... tree layout at the destination.
# Guard the destination: if MOCKINGBUOY_BACKUP_DEST is empty, systemd would drop the
# trailing argument and rsync would treat a LOCAL path as the target and --delete into it.
# The ${VAR:?msg} expansion makes an unset/empty destination a hard, immediate failure.
ExecStart=/bin/sh -c ': "${MOCKINGBUOY_BACKUP_DEST:?set MOCKINGBUOY_BACKUP_DEST in secrets/service.env}"; \
    exec /usr/bin/rsync -aR --delete --mkpath \
        /opt/mockingbuoy/config.json \
        /opt/mockingbuoy/secrets \
        /opt/mockingbuoy/data \
        "${MOCKINGBUOY_BACKUP_DEST}"'

# Bound the run so a hung rsync (dead LAN share, stalled ssh) cannot wedge the unit forever.
TimeoutStartSec=30m

# Modest sandboxing for the backup job (read-most; rsync only reads locally).
# NOTE (C3, deferred): a mounted-share destination needs `ReadWritePaths=<mount>` added here
# (ProtectSystem=strict makes the FS read-only otherwise), and an rsync-over-ssh destination
# needs a provisioned keypair + pre-seeded known_hosts for the nologin service user. Those,
# plus encrypted dated generations (tar | age) instead of a single `rsync --delete` copy, are
# the remaining redesign items; the timer stays DISABLED until they land.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
