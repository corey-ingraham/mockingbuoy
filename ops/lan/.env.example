# Copy to ops/lan/.env and set the box's STATIC / DHCP-reserved primary LAN IP on the deployment
# network. REQUIRED and load-bearing: AdGuard answers *.eemslab.internal with this IP and the raw-IP
# Caddy alias points here, so the box MUST have a stable IP. If it changes, DNS answers (and every
# client's configured DNS server address) break.
BOX_IP=192.168.1.10
