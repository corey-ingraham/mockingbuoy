# udev rules for mockingbuoy USB-serial adapters.
#
# Goal: give each physical adapter a STABLE, friendly /dev/nmea-* name regardless of
# enumeration order, hand it to the dialout group at mode 0660, tune FTDI latency, and
# tag it TAG+="systemd" so the service unit can reference it in DeviceAllow=.
#
# Install:
#   sudo install -m 0644 ops/99-mockingbuoy.rules /etc/udev/rules.d/99-mockingbuoy.rules
#   sudo udevadm control --reload && sudo udevadm trigger
#   ls -l /dev/nmea-*        # confirm the symlinks resolve to the right ttyUSB*/ttyACM*
#
# Find the per-adapter attributes to fill in below (serial number is the stable key):
#   udevadm info -a -n /dev/ttyUSB0 | grep -E 'ATTRS\{(serial|idVendor|idProduct)\}'
#
# ALL identifiers below are PLACEHOLDERS — replace <...> with your adapters' values.
# Each line keys on ATTRS{serial} so replugging any port yields the same name.

# --- GPS adapter -------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<GPS_SERIAL>", \
    SYMLINK+="nmea-gps", GROUP="dialout", MODE="0660", TAG+="systemd"

# --- Heading adapter ---------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<HEADING_SERIAL>", \
    SYMLINK+="nmea-heading", GROUP="dialout", MODE="0660", TAG+="systemd"

# --- AIS adapter -------------------------------------------------------------
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<AIS_SERIAL>", \
    SYMLINK+="nmea-ais", GROUP="dialout", MODE="0660", TAG+="systemd"

# --- INPUT / diagnostic slots (LISTEN-ONLY, RX) ------------------------------
# The three symlinks above are TX OUTPUT adapters — the app writes generated
# NMEA/AIS sentences OUT to them. The six slots below are the RX INPUT side:
# LISTEN-ONLY adapters the app reads FROM. They feed both:
#   - Auto-mode inputs (an upstream sensor drives the sim), and
#   - the Maintenance multi-port view (up to 6 concurrent inbound ports).
# These are a DISTINCT role from the TX outputs above — same udev pattern, but
# separate stable names so a slot never collides with an output symlink.
#
# The operator maps a physical adapter to a slot by its serial: pick which
# inbound port becomes nmea-in-1 .. nmea-in-6 by filling in the ATTRS{serial}
# placeholder on the matching line. Unused slots simply stay unmatched (the
# symlink is never created) — that is fine; provision only what you plug in.
#
# Same ownership/mode as the outputs: GROUP="dialout" + MODE="0660" so the
# service user (in dialout) can open them, TAG+="systemd" so the unit can name
# them in DeviceAllow=. Listen-only is enforced in SOFTWARE (the app opens these
# read-only unless a Maintenance diagnostic explicitly reconfigures a NON-
# operational slot); udev only fixes the name/owner, not the read/write intent.
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN1_SERIAL>", \
    SYMLINK+="nmea-in-1", GROUP="dialout", MODE="0660", TAG+="systemd"
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN2_SERIAL>", \
    SYMLINK+="nmea-in-2", GROUP="dialout", MODE="0660", TAG+="systemd"
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN3_SERIAL>", \
    SYMLINK+="nmea-in-3", GROUP="dialout", MODE="0660", TAG+="systemd"
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN4_SERIAL>", \
    SYMLINK+="nmea-in-4", GROUP="dialout", MODE="0660", TAG+="systemd"
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN5_SERIAL>", \
    SYMLINK+="nmea-in-5", GROUP="dialout", MODE="0660", TAG+="systemd"
SUBSYSTEM=="tty", ATTRS{idVendor}=="<VID>", ATTRS{idProduct}=="<PID>", ATTRS{serial}=="<IN6_SERIAL>", \
    SYMLINK+="nmea-in-6", GROUP="dialout", MODE="0660", TAG+="systemd"

# --- FTDI latency tuning -----------------------------------------------------
# FTDI defaults to a 16 ms read latency timer; drop it to 1 ms so per-sentence writes
# aren't coalesced/delayed. Applies to the FTDI USB device node backing the tty.
# (Harmless no-op on non-FTDI adapters, which won't match ATTR{latency_timer}.)
SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTR{latency_timer}="1"
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTR{device/latency_timer}="1"

# --- brltty gotcha -----------------------------------------------------------
# brltty (Braille display daemon) aggressively grabs FTDI serial adapters via its own
# udev rules and can steal the port out from under this service. If you don't use a
# Braille display, mask/remove it so the tty stays available:
#   sudo systemctl mask brltty.service brltty.path 2>/dev/null || true
#   sudo apt-get purge -y brltty            # or: rm /usr/lib/udev/rules.d/*brltty*.rules
