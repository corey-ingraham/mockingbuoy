# mockingbuoy — native ASGI service (Python venv + uvicorn), fronted by Caddy.
#
# Install:
#   sudo install -m 0644 ops/mockingbuoy.service /etc/systemd/system/mockingbuoy.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mockingbuoy.service
#
# The app binds a UNIX-DOMAIN SOCKET at /run/mockingbuoy/app.sock (shipped default);
# Caddy terminates TLS + Basic auth and reverse-proxies to it over that socket. No host
# port is published by this service. A loopback-TCP bind is preserved as a commented
# fallback (see the ExecStart block) for operators who prefer TCP.

[Unit]
Description=mockingbuoy NMEA/AIS simulator (loopback ASGI app)
Documentation=file:///opt/mockingbuoy/docs/ref/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated non-login service user; dialout is required to open serial adapters.
User=mockingbuoy
Group=mockingbuoy
SupplementaryGroups=dialout

WorkingDirectory=/opt/mockingbuoy

# Default loopback port; overridden by service.env (loaded after, so the file wins) when the
# operator sets MOCKINGBUOY_APP_PORT via setup.env. Keeps the ${...} expansion below non-empty.
Environment=MOCKINGBUOY_APP_PORT=8000
# Optional runtime env (in-app Basic user/hash, app port, etc). Leading '-' => not an error if absent.
EnvironmentFile=-/opt/mockingbuoy/secrets/service.env

# ---------------------------------------------------------------------------
# APP BIND — UNIX-DOMAIN SOCKET (shipped default)
# ---------------------------------------------------------------------------
# WHY a socket instead of loopback TCP:
#   A 127.0.0.1:PORT bind is reachable by ANY local user/process on the host —
#   the loopback listener has no owner-based access control. The unix socket
#   below closes that local surface: it is filesystem-permissioned, so it is
#   reachable only by root, the mockingbuoy user, and members of the mockingbuoy
#   group. Caddy is granted access by joining that group (SupplementaryGroups=
#   mockingbuoy in ops/caddy.service.d/override.conf) — nothing else on the box
#   can reach the app.
#
# The socket lives in a tmpfs runtime dir that systemd creates/tears down:
#   RuntimeDirectory=mockingbuoy      -> /run/mockingbuoy, owned mockingbuoy:mockingbuoy
#   RuntimeDirectoryMode=0750         -> group may traverse into it (Caddy needs this)
#   UMask=0007                        -> the socket uvicorn creates is group-rw (0660-ish),
#                                        NOT 0600, so the mockingbuoy group can connect.
RuntimeDirectory=mockingbuoy
RuntimeDirectoryMode=0750
UMask=0007
#
# Tell the app how it is bound so /api/security reports the truth (optional hint;
# defaults to 127.0.0.1 when unset, keeping dev/TCP output unchanged).
Environment=MOCKINGBUOY_APP_BIND=/run/mockingbuoy/app.sock
#
# VERIFY ON TARGET: this socket wiring has NOT been run on the target host.
# Before trusting it, validate on the box that:
#   - /run/mockingbuoy/app.sock exists after start (ls -l /run/mockingbuoy/)
#   - its perms are group-accessible (srw-rw---- mockingbuoy mockingbuoy)
#   - Caddy can actually connect (curl through the proxy returns the UI, and
#     `journalctl -u caddy` shows no "connection refused"/"permission denied")
# If any of that fails, fall back to the commented TCP ExecStart below.
#
# Serve the ASGI app from the venv. Single worker, no access log.
# NEVER add --reload (dev-only; spawns a reloader subprocess and watches the tree).
ExecStart=/opt/mockingbuoy/.venv/bin/uvicorn web.app:app \
    --uds /run/mockingbuoy/app.sock \
    --workers 1 \
    --no-access-log \
    --timeout-graceful-shutdown 25
#
# --- TCP LOOPBACK FALLBACK (commented) -------------------------------------
# Operators who prefer a loopback-TCP bind can swap the ExecStart above for the
# form below (and also flip the RuntimeDirectory/UMask/socket bits back out, set
# MOCKINGBUOY_APP_BIND=127.0.0.1, and point Caddy's reverse_proxy at 127.0.0.1:PORT).
# ExecStart=/opt/mockingbuoy/.venv/bin/uvicorn web.app:app \
#     --host 127.0.0.1 \
#     --port ${MOCKINGBUOY_APP_PORT} \
#     --workers 1 \
#     --no-access-log \
#     --timeout-graceful-shutdown 25

Restart=on-failure
RestartSec=3
# Must exceed --timeout-graceful-shutdown (25s) so in-flight SSE drains before SIGKILL.
TimeoutStopSec=30
# Optional liveness watchdog — the app must sd_notify WATCHDOG=1 within the period.
# Leave disabled unless the app implements the notify protocol.
# WatchdogSec=30

# ---------------------------------------------------------------------------
# Sandboxing — drop all privileges, make the rootfs read-only, restrict syscalls
# and devices, and cap the process to only what it needs.
# ---------------------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# The only writable path the app needs (runtime state). Everything else is read-only.
ReadWritePaths=/opt/mockingbuoy/data

# MemoryDenyWriteExecute hardens against W^X code injection. The deps here are
# pure-Python, but some environments ship C extensions (or a JIT) that map W+X pages
# and will crash under this. Enable ONLY after verifying the venv starts with it on.
# MemoryDenyWriteExecute=true

# Resource caps (active). WHY: a single-worker uvicorn serving a handful of serial
# channels + SSE clients has a small, predictable footprint; these ceilings contain a
# runaway (leak, fork storm, hot loop) so it degrades this service instead of the whole
# appliance. MemoryHigh throttles (reclaim pressure) before MemoryMax hard-kills; the
# gap gives headroom to shed load rather than OOM outright. Tune up if the target host
# is larger or runs more channels.
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
CPUWeight=50
CPUQuota=150%
IOWeight=50
#
# ALSO RECOMMENDED (not set here — these belong elsewhere, not in this unit):
#   - Cap the journal so logs can't fill the disk: a journald drop-in with
#     Storage=volatile (RAM-only) OR SystemMaxUse=50M in
#     /etc/systemd/journald.conf.d/mockingbuoy.conf. Journald caps live in
#     journald.conf.d, NOT in a service unit, so we do not inline them here.
#   - Prefer NVMe (or an external SSD) over a microSD card for /var and the data
#     dir: microSD wears out and corrupts under sustained write load, which is the
#     usual durability failure mode for this class of appliance.

# ---------------------------------------------------------------------------
# SERIAL GOTCHA (critical): do NOT set PrivateDevices=yes — it hides /dev/tty* and
# the serial adapters vanish from the service's mount namespace. Instead we keep the
# dialout group AND grant the specific char devices explicitly.
#
# ops/99-mockingbuoy.rules creates stable /dev/nmea-* symlinks for the USB-serial adapters.
#
# HOTPLUG GOTCHA (M19): a per-SYMLINK grant like `DeviceAllow=/dev/nmea-gps rw` is resolved
# to a fixed major:minor ONCE, at unit start. When an adapter is unplugged/replugged it
# re-enumerates to a NEW minor (ttyUSB0 -> ttyUSB1), which no longer matches the cached
# grant -> open() returns EPERM. That silently breaks the very auto-mode failover this
# appliance exists for (a replug looks like flaky hardware). So we grant by CHAR-MAJOR
# CLASS instead — the class covers every current and future minor in that class, so a
# replug stays permitted with no unit restart. This is broader than the per-symlink form,
# but the app still opens only its configured paths, and PrivateDevices stays off so the
# ttys remain visible in the service's mount namespace.
#
# Covers the TX outputs (nmea-gps/heading/ais) AND the six LISTEN-ONLY RX input/diagnostic
# slots (nmea-in-1 .. nmea-in-6). Granted 'rw' (not 'r') because a Maintenance diagnostic —
# auto-baud probe, loopback, or test-send — may reconfigure/write a NON-operational slot;
# day-to-day read-only behaviour is enforced in SOFTWARE (the app opens RX slots read-only).
# FT232/FT-X and CH34x adapters enumerate as ttyUSB; CDC-ACM adapters as ttyACM.
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

[Install]
WantedBy=multi-user.target
