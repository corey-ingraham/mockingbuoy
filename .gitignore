# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Secrets — NEVER commit (generated on-device at setup)
secrets/*
!secrets/.gitkeep
!secrets/service.env.example
*.key
*.pem
setup.env

# Build / deploy artifacts (portable image exports, local config overrides)
images/
*.tar
config.local.json

# Operator data — NEVER commit. The persist target (data/config.local.json) and any other
# runtime-written operator state live here; only the tracked .gitkeep keeps the dir in a clone.
data/*
!data/.gitkeep
# Offline redeploy wheel cache — third-party binaries, never commit
wheelhouse/
*.whl

# Private area-realism work — NEVER commit (local-only data, profiles, tooling)
private/
data/ais/
*.parquet
*.csv
profiles/*.local.json

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Untracked whole-repo red-team scratch report (never commit)
.redteam-report.md

# Machine-local subagent memory (never committed)
.claude/agent-memory-local/

# Repo assistant instructions. Deliberately NOT committed: this file carries the deployment's use
# case, site names and bench topology, which hard rule #8 keeps out of a public artifact.
#
# This rule used to live only in .git/info/exclude, which is PER-CLONE — so the protection did not
# travel. A second machine that created a CLAUDE.md would see it as untracked and could commit it
# straight into the public history. Declaring it here makes the rule propagate to every clone; the
# rule leaks nothing, only the content would have.
#
# Consequence: CLAUDE.md is not synced by git. Keep it in the out-of-band sync location instead
# (see CONTRIBUTING.md, "Working files git does not carry").
/CLAUDE.md
