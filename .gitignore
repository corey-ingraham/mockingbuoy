# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Secrets — NEVER commit (generated on-device at setup)
secrets/*
!secrets/.gitkeep
!secrets/service.env.example
*.key
*.pem
setup.env

# Build / deploy artifacts (portable image exports, local config overrides)
images/
*.tar
config.local.json

# Operator data — NEVER commit. The persist target (data/config.local.json) and any other
# runtime-written operator state live here; only the tracked .gitkeep keeps the dir in a clone.
data/*
!data/.gitkeep
# Offline redeploy wheel cache — third-party binaries, never commit
wheelhouse/
*.whl

# Private area-realism work — NEVER commit (local-only data, profiles, tooling)
private/
data/ais/
*.parquet
*.csv
profiles/*.local.json

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Untracked whole-repo red-team scratch report (never commit)
.redteam-report.md

# Machine-local subagent memory (never committed)
.claude/agent-memory-local/
