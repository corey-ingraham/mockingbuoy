# service.env.example — NON-SECRET template. Names only, placeholder values.
#
# Copy to secrets/service.env (git-ignored) and fill in on-device:
#   cp secrets/service.env.example secrets/service.env
#   chmod 0600 secrets/service.env
#
# secrets/service.env is read by both mockingbuoy.service and the Caddy drop-in
# (EnvironmentFile=-/opt/mockingbuoy/secrets/service.env). It must NEVER be committed
# (secrets/* is git-ignored except .gitkeep and this .example).
#
# Do NOT put a plaintext password here. Store only the Caddy bcrypt HASH, generated on
# the host:
#   caddy hash-password            # prompts, prints the $2a$... bcrypt hash

# LAN address Caddy publishes on :443 (LAN NIC IP, or a local hostname). Never 0.0.0.0.
MOCKINGBUOY_SITE=<LAN_IP>

# Basic-auth username guarding the whole site.
MOCKINGBUOY_BASIC_USER=<you>

# Basic-auth bcrypt hash from `caddy hash-password` (the $2a$... string, quoted).
MOCKINGBUOY_BASIC_HASH="<bcrypt-hash-from-caddy-hash-password>"

# rsync destination for the daily host backup (LAN share). Used by
# ops/mockingbuoy-backup.service. Example form only:
MOCKINGBUOY_BACKUP_DEST=<user@host:/path/to/backups/mockingbuoy>
