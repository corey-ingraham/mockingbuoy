# mockingbuoy — Caddy SITE SNIPPET, imported by the shared host Caddyfile.
#
# setup.sh installs this file to /etc/caddy/conf.d/mockingbuoy.caddy; the shared
# /etc/caddy/Caddyfile does `import /etc/caddy/conf.d/*.caddy`, so this block coexists with
# NetBox and any other reverse-proxy sites on the box. This file holds ONE site block and NO
# global options (globals like `admin off` live in the shared main Caddyfile — a global block
# inside an imported snippet is invalid).
#
# SSE + auth interaction (why Basic-at-proxy works for the live stream):
#   The UI streams sentences over Server-Sent Events via the browser's EventSource, which CANNOT
#   set request headers. Basic auth enforced HERE still works because, once the user has
#   authenticated the origin, the browser re-sends the cached Basic credentials on every
#   same-origin request, EventSource included. flush_interval -1 disables response buffering so
#   streamed events reach the browser immediately.
#
# Addresses: the primary is the friendly hostname (MOCKINGBUOY_SITE, e.g. mockingbuoy.eemslab);
# the second is a raw-IP alias (MOCKINGBUOY_SITE_ALIAS = the box LAN IP) so the UI stays reachable
# by IP even before local DNS resolves the name. setup.sh composes both into service.env and dedups
# them (alias falls back to 127.0.0.1 when it would duplicate the primary).
#
# Secrets: the Basic password HASH is produced on-device with `caddy hash-password` and injected via
# MOCKINGBUOY_BASIC_HASH (kept in git-ignored secrets/, never here).

{$MOCKINGBUOY_SITE:mockingbuoy.eemslab.internal}:443, {$MOCKINGBUOY_SITE_ALIAS:127.0.0.1}:443 {
	# Local-only TLS: Caddy's internal issuer signs from a custom local root CA (trust the root on
	# client devices for a green padlock). Never public ACME — this host is LAN-only.
	tls internal

	# HTTP Basic guarding everything. User/hash come from the environment; the hash is a bcrypt
	# string from `caddy hash-password` living in git-ignored secrets/.
	basic_auth {
		{$MOCKINGBUOY_BASIC_USER:<you>} {$MOCKINGBUOY_BASIC_HASH}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# The UI's script + stylesheet are served as same-origin ('self') files under /static, so
		# script-src stays strict (no 'unsafe-inline') — the real XSS guard. style-src keeps
		# 'unsafe-inline' only because the page still uses inline style="" layout attributes (no
		# inline <script> or on* handlers remain, so scripts can never be injected inline).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
		X-Frame-Options DENY
		# Measured HSTS: 1 year, this host only. No preload / no includeSubDomains.
		Strict-Transport-Security "max-age=31536000"
		# Don't advertise the server software.
		-Server
	}

	# Unix-socket app bind (shipped default). Caddy reaches the socket by being a member of the
	# mockingbuoy group (SupplementaryGroups=mockingbuoy in the caddy override); the socket is
	# created by the app's RuntimeDirectory. flush_interval -1 => stream SSE unbuffered.
	reverse_proxy unix//run/mockingbuoy/app.sock {
		flush_interval -1
	}
	# --- TCP LOOPBACK FALLBACK (commented) ---------------------------------------
	# If the service is switched back to a loopback-TCP bind (see the commented ExecStart in
	# ops/mockingbuoy.service), use this target instead:
	# reverse_proxy 127.0.0.1:{$MOCKINGBUOY_APP_PORT:8000} {
	# 	flush_interval -1
	# }
}
